PORT=3000
# Public hostname Twilio can reach (ngrok or deploy host), no scheme. Falls back to the request Host header.
PUBLIC_HOST=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# echo   = caller hears themselves (proves audio in/out on one phone)
# raw    = A and B hear each other untranslated through the server (proves the bridge)
# translate = full pipeline: each side hears the other translated (see PIPELINE below)
BRIDGE_MODE=echo
# Twilio number -> persona. forwardTo is the teammate's real cell.
PERSONAS_JSON={"+15550000001":{"name":"Olena","lang":"uk","forwardTo":"+15550000099","voiceId":""}}
DEFAULT_CALLER_LANG=en
RING_TIMEOUT_SEC=25

# --- Translation pipeline (BRIDGE_MODE=translate) ---
# real = vendor modules; fake = offline stand-ins using macOS `say`, for the simulator and tests
PIPELINE=real
# tone = fake TTS emits a beep instead of running `say`
FAKE_TTS=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Stock ElevenLabs voices used until a live clone is ready
FALLBACK_VOICE_M=
FALLBACK_VOICE_F=
# groq | anthropic | deepl
TRANSLATE_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEEPL_API_KEY=
# Set to false to skip live-cloning the caller and keep the stock voice
CLONE_JUDGE=true
